# Verirun settings. Copy to .env and fill in.
# Any OpenAI-compatible chat-completions endpoint works.

VERIRUN_BASE_URL=https://opencode.ai/zen/go/v1
# Required for live and record modes; leave empty for offline replay/tests.
VERIRUN_API_KEY=

# Model roles: the fast tool loop, the stronger planner/verifier, and vision
# for scanned documents.
VERIRUN_MODEL_LOOP=deepseek-v4.1-flash
VERIRUN_MODEL_REASON=deepseek-v4-pro
VERIRUN_MODEL_VISION=deepseek-v4-flash-vision-exp

# live   — call the gateway on every turn
# record — call live and write one fixture per request into VERIRUN_FIXTURE_DIR
# replay — serve recorded fixtures, offline and free (used by the test suite)
VERIRUN_LLM_MODE=live
VERIRUN_FIXTURE_DIR=tests/fixtures/llm

VERIRUN_COMPANY_DIR=company
VERIRUN_TASKS_DIR=tasks
VERIRUN_RUN_DB=runs/verirun.db
VERIRUN_SHARED_DIR=shared
VERIRUN_MAIL_DB=mocks/state/maildesk.db
VERIRUN_ERP_DB=mocks/state/ledgerlite.db

# Product mail source. Leave IMAP and the watched folder unset to use MailDesk.
# IMAP takes precedence when both are configured. The app password is never
# logged; the local index stores UIDVALIDITY/UID and message metadata.
# VERIRUN_IMAP_HOST=imap.example.com
# VERIRUN_IMAP_PORT=993
# VERIRUN_IMAP_USERNAME=ap@example.com
# VERIRUN_IMAP_PASSWORD=
# VERIRUN_IMAP_FOLDER=INBOX
# VERIRUN_IMAP_SSL=true
# VERIRUN_WATCH_DIR=/srv/verirun/inbox
VERIRUN_MAIL_STATE_DB=runs/mail-index.db

# Per-run safety limits: a Run stops in limit_reached at either bound.
VERIRUN_MAX_STEPS=60
VERIRUN_MAX_COST_USD=5.0

# Zoho Books India, read-only. Set all of these to replace LedgerLite with a
# Zoho Books organisation. Create a Self Client in the Zoho API console (India
# DC) with scopes ZohoBooks.contacts.READ, ZohoBooks.purchaseorders.READ,
# ZohoBooks.bills.READ, and ZohoBooks.vendorpayments.READ, then exchange its
# grant token for a refresh token.
# VERIRUN_ZOHO_ORGANIZATION_ID=
# VERIRUN_ZOHO_CLIENT_ID=
# VERIRUN_ZOHO_CLIENT_SECRET=
# VERIRUN_ZOHO_READ_REFRESH_TOKEN=
# Operator secret used to encrypt the token file; keep it stable.
# VERIRUN_ZOHO_TOKEN_KEY=
# VERIRUN_ZOHO_READ_TOKEN_FILE=runs/zoho-read-token.enc
# VERIRUN_ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
# VERIRUN_ZOHO_API_BASE_URL=https://www.zohoapis.in/books/v3
# VERIRUN_ZOHO_TIMEOUT_S=30

# Per-request model timeout in seconds. Reasoning models can think for minutes;
# transient timeouts are retried automatically before the Run fails.
VERIRUN_REQUEST_TIMEOUT_S=600
