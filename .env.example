# Operator settings. Copy to .env and fill in.
# Any OpenAI-compatible chat-completions endpoint works.

OPERATOR_BASE_URL=https://opencode.ai/zen/go/v1
OPERATOR_API_KEY=
OPERATOR_MODEL_LOOP=deepseek-v4.1-flash
OPERATOR_MODEL_REASON=deepseek-v4-pro
OPERATOR_MODEL_VISION=deepseek-v4-flash-vision-exp

# live | record | replay
OPERATOR_LLM_MODE=live
OPERATOR_FIXTURE_DIR=tests/fixtures/llm

OPERATOR_COMPANY_DIR=company
OPERATOR_TASKS_DIR=tasks
OPERATOR_RUN_DB=runs/operator.db

OPERATOR_MAX_STEPS=60
OPERATOR_MAX_COST_USD=5.0
