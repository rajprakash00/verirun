# Operator settings. Copy to .env and fill in.
# Any OpenAI-compatible chat-completions endpoint works.

OPERATOR_BASE_URL=https://opencode.ai/zen/go/v1
# Required for live and record modes; leave empty for offline replay/tests.
OPERATOR_API_KEY=

# Model roles: the fast tool loop, the stronger planner/verifier, and vision
# for scanned documents.
OPERATOR_MODEL_LOOP=deepseek-v4.1-flash
OPERATOR_MODEL_REASON=deepseek-v4-pro
OPERATOR_MODEL_VISION=deepseek-v4-flash-vision-exp

# live   — call the gateway on every turn
# record — call live and write one fixture per request into OPERATOR_FIXTURE_DIR
# replay — serve recorded fixtures, offline and free (used by the test suite)
OPERATOR_LLM_MODE=live
OPERATOR_FIXTURE_DIR=tests/fixtures/llm

OPERATOR_COMPANY_DIR=company
OPERATOR_TASKS_DIR=tasks
OPERATOR_RUN_DB=runs/operator.db
OPERATOR_SHARED_DIR=shared
OPERATOR_MAIL_DB=mocks/state/maildesk.db
OPERATOR_ERP_DB=mocks/state/ledgerlite.db

# Per-run safety limits: a Run stops in limit_reached at either bound.
OPERATOR_MAX_STEPS=60
OPERATOR_MAX_COST_USD=5.0

# Per-request model timeout in seconds. Reasoning models can think for minutes;
# transient timeouts are retried automatically before the Run fails.
OPERATOR_REQUEST_TIMEOUT_S=600
